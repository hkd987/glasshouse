#!/bin/sh
#
# PROVIDE: glassd
# REQUIRE: LOGIN FILESYSTEMS
# KEYWORD: shutdown suspend resume
#
# Glasshouse system daemon. Enable with:  sysrc glassd_enable=YES
#
# The suspend and resume keywords make /etc/rc.suspend and /etc/rc.resume
# run "glassd suspend" before the machine sleeps (it waits for us) and
# "glassd resume" after it wakes, so agents pause for sleep (PRD PM-5).
#
# glassd_config  (path)  Config file. Default /usr/local/etc/glasshouse/glassd.toml
# glassd_log     (path)  Daemon log. Default /var/log/glassd.log
# glassd_restart_delay (secs)  How long after a crash glassd starts again.
#                              Default 3

# rc.subr reads the rc variables below, and FreeBSD's sh has `local`.
# shellcheck disable=SC1091,SC2034,SC3043
. /etc/rc.subr

name="glassd"
rcvar="glassd_enable"
load_rc_config "$name"

: "${glassd_enable:=NO}"
: "${glassd_config:=/usr/local/etc/glasshouse/glassd.toml}"
: "${glassd_log:=/var/log/glassd.log}"
: "${glassd_restart_delay:=3}"

# daemon(8) supervises glassd and starts it again a few seconds after it
# stops without being asked to, at most 100 times (ADR 0055, Boot.tla):
# a crash doesn't leave the computer without agents until it restarts.
# rc tracks the supervisor (-P); stopping it forwards the stop to glassd
# and nothing starts it again. glassd's own pid stays in glassd.pid.
pidfile="/var/run/${name}_supervisor.pid"
procname="/usr/sbin/daemon"
command="/usr/sbin/daemon"
glassd_bin="/usr/local/sbin/glassd"
# glassd checks its config and policy as it starts and, with
# --console-errors, says on the console why if it won't run (BR-1: the
# message names Glasshouse only).
command_args="-f -R ${glassd_restart_delay} -C 100 -P ${pidfile} -p /var/run/${name}.pid -o ${glassd_log} ${glassd_bin} --config ${glassd_config} --console-errors"
start_precmd="glassd_precmd"
stop_precmd="glassd_stop_precmd"
extra_commands="suspend resume"
suspend_cmd="glassd_suspend"
resume_cmd="glassd_resume"

glassd_precmd()
{
	# At boot glassd's own checks are enough: running them here too would
	# start glassd twice on the way to the login screen (ADR 0021). Started
	# by hand, check first, so a refusal shows on the terminal that asked.
	[ -n "${rc_fast}" ] && return 0
	local out
	if ! out=$("${glassd_bin}" --config "${glassd_config}" --check 2>&1); then
		echo "${out}" >&2
		return 1
	fi
}

glassd_stop_precmd()
{
	# As the computer shuts down (rc.shutdown stops it with faststop): a
	# kernel patch on probation is started again by the next start, once. A
	# crash never gets here, so the start after one goes back (ADR 0057,
	# HardwarePatch.tla). Never hold up shutdown on an error.
	[ -n "${rc_fast}" ] && glassd_ctl system shutdown >/dev/null 2>&1
	return 0
}

# glassctl for the hooks the computer's sleep, wake and shutdown wait on.
# glassd holds agents within two seconds, and glassctl gives up on an
# answer after ten; timeout(1) is for what neither covers, such as a glassd
# too stuck to take the connection. Nothing here may hold those up.
glassd_ctl()
{
	if [ -x /usr/bin/timeout ]; then
		/usr/bin/timeout 15 /usr/local/bin/glassctl "$@"
	else
		/usr/local/bin/glassctl "$@"
	fi
}

glassd_suspend()
{
	glassd_ctl system suspend || true
}

glassd_resume()
{
	glassd_ctl system resume || true
}

run_rc_command "$1"
