#!/bin/sh
#
# PROVIDE: glasshouse_greeter
# REQUIRE: LOGIN glassd
# KEYWORD: nojail shutdown
#
# The sign-in screen on the first virtual terminal (ADR 0019): glass-greeter
# checks passwords with PAM, starts the person's desktop, and shows the
# sign-in screen again when they sign out. getty can't share ttyv0 with it:
# starting turns getty off there in /etc/ttys, and stopping turns it back on
# once the greeter is disabled.

# rc.subr reads the rc variables below, and FreeBSD's sh has `local`.
# shellcheck disable=SC1091,SC2034,SC3043
. /etc/rc.subr

name="glasshouse_greeter"
desc="The Glasshouse sign-in screen"
rcvar="glasshouse_greeter_enable"
# daemon(8) supervises the sign-in screen as it does glassd (ADR 0055): it
# starts glass-greeter again two seconds after it stops without being
# asked to. getty is off on this terminal, so a sign-in screen that died
# and stayed dead left no way to sign in until the computer was restarted.
# rc tracks the supervisor (-P): stopping it forwards SIGTERM to
# glass-greeter, which ends the sign-in screen or desktop showing before it
# exits, and nothing starts it again. glass-greeter's own pid stays in
# glasshouse_greeter.pid. -H: the supervisor opens the log again when
# newsyslog has moved it aside (newsyslog.conf.d/glasshouse.conf).
pidfile="/var/run/${name}_supervisor.pid"
procname="/usr/sbin/daemon"
command="/usr/sbin/daemon"
greeter_bin="/usr/local/bin/glass-greeter"
command_args="-f -H -R 2 -P ${pidfile} -p /var/run/${name}.pid -o /var/log/glass-greeter.log ${greeter_bin}"

start_precmd="glasshouse_greeter_prestart"
stop_postcmd="glasshouse_greeter_stopped"

glasshouse_greeter_prestart()
{
	# A sign-in screen started before this script supervised it has its pid
	# in glasshouse_greeter.pid and no supervisor, so stopping didn't find
	# it (an update that replaced the script under it): ended here, or two
	# would draw on the one screen.
	if [ ! -f "${pidfile}" ] && [ -f "/var/run/${name}.pid" ]; then
		pkill -F "/var/run/${name}.pid" glass-greeter 2>/dev/null && sleep 1
		rm -f "/var/run/${name}.pid"
	fi
	glasshouse_greeter_getty off
}

# A restart, or a shutdown while the greeter is on, leaves getty off: one
# started in between would draw its login prompt over the sign-in screen.
glasshouse_greeter_stopped()
{
	checkyesno glasshouse_greeter_configured || glasshouse_greeter_getty onifexists
}

# glasshouse_greeter_getty off|onifexists: whether getty runs on ttyv0.
glasshouse_greeter_getty()
{
	local want="$1"
	if grep -Eq "^ttyv0[[:space:]].*[[:space:]]${want}([[:space:]]|\$)" /etc/ttys; then
		return 0
	fi
	sed -i '' -E "/^ttyv0[[:space:]]/s/[[:space:]](on|off|onifexists|onifconsole)([[:space:]]|\$)/ ${want}\2/" /etc/ttys
	# init(8) rereads /etc/ttys, ending or starting getty there.
	kill -HUP 1
}

load_rc_config "$name"
: "${glasshouse_greeter_enable:=NO}"
# What rc.conf says: `onestop` turns the rcvar on for itself.
glasshouse_greeter_configured="$glasshouse_greeter_enable"

run_rc_command "$1"
