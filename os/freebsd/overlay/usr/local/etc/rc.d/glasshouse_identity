#!/bin/sh
#
# PROVIDE: glasshouse_identity
# REQUIRE: mountcritremote FILESYSTEMS os-release motd
# BEFORE:  LOGIN
# KEYWORD: nojail
#
# BR-1: the system says Glasshouse wherever users look. Writes the OS
# identity (/etc/os-release), which the base system would otherwise fill in
# with its own name, and keeps the boot menu's console right for this
# machine's firmware. post-install.sh turns the base writers
# (osrelease_enable, update_motd) off and points /etc/motd at our login
# message.
#
# It runs on every boot, on the way to the login screen, so it uses shell
# builtins wherever it can: each program it started cost a fifth of a
# second in the emulated VM (docs/dev/performance.md, "Boot").

# rc.subr reads the rc variables below, and FreeBSD's sh has `local`.
# shellcheck disable=SC1091,SC2034,SC3043
. /etc/rc.subr

name="glasshouse_identity"
desc="Write the Glasshouse OS identity"
rcvar="glasshouse_identity_enable"
start_cmd="glasshouse_identity_start"
stop_cmd=":"

branding=/usr/local/share/glasshouse/branding

glasshouse_identity_start()
{
	local key value version build console current

	if [ -r "$branding/build-info" ]; then
		while IFS='=' read -r key value; do
			case $key in
			version) version=$value ;;
			build) build=$value ;;
			esac
		done <"$branding/build-info"
	fi
	# /var/run is emptied at every boot (cleanvar), so this is written
	# each time.
	printf '%s\n' NAME=Glasshouse "VERSION=\"${version:-dev}\"" \
		"VERSION_ID=\"${version:-0}\"" "BUILD_ID=\"${build:-unknown}\"" \
		ID=glasshouse "PRETTY_NAME=\"Glasshouse ${version:-dev}\"" >/var/run/os-release
	[ -h /etc/os-release ] || ln -sf ../var/run/os-release /etc/os-release

	# The boot menu (our brand and logo) draws on the firmware's screen
	# console and the serial one. The loader rejects the whole list if one
	# name doesn't exist, so match it to how this machine boots.
	case $(sysctl -n machdep.bootmethod 2>/dev/null) in
	UEFI) console="efi" ;;
	*) console="comconsole,vidconsole" ;;
	esac
	while IFS= read -r key; do
		case $key in
		console=*)
			current=${key#console=}
			current=${current#\"}
			current=${current%\"}
			;;
		esac
	done </boot/loader.conf
	if [ "$current" != "$console" ]; then
		sysrc -q -f /boot/loader.conf console="$console" >/dev/null
	fi
}

load_rc_config "$name"
: "${glasshouse_identity_enable:=NO}"

run_rc_command "$1"
