#!/bin/sh
#
# PROVIDE: glasshouse_identity
# REQUIRE: mountcritremote FILESYSTEMS os-release motd
# BEFORE:  LOGIN
# KEYWORD: nojail
#
# BR-1: the system says Glasshouse wherever users look. Writes the OS
# identity (/etc/os-release) and the login message (/etc/motd), which the
# base system would otherwise fill in with its own name, and keeps the boot
# menu's console right for this machine's firmware. post-install.sh turns
# the base writers (osrelease_enable, update_motd) off.

# rc.subr reads the rc variables below, and FreeBSD's sh has `local`.
# shellcheck disable=SC1091,SC2034,SC3043
. /etc/rc.subr

name="glasshouse_identity"
desc="Write the Glasshouse OS identity and login message"
rcvar="glasshouse_identity_enable"
start_cmd="glasshouse_identity_start"
stop_cmd=":"

branding=/usr/local/share/glasshouse/branding

glasshouse_identity_start()
{
	local version build t console

	version=$(sed -n 's/^version=//p' "$branding/build-info" 2>/dev/null)
	build=$(sed -n 's/^build=//p' "$branding/build-info" 2>/dev/null)
	t=$(mktemp -t os-release)
	cat > "$t" <<-__EOF__
		NAME=Glasshouse
		VERSION="${version:-dev}"
		VERSION_ID="${version:-0}"
		BUILD_ID="${build:-unknown}"
		ID=glasshouse
		PRETTY_NAME="Glasshouse ${version:-dev}"
	__EOF__
	install -C -o root -g wheel -m 444 "$t" /var/run/os-release
	rm -f "$t"
	[ -h /etc/os-release ] || ln -sf ../var/run/os-release /etc/os-release

	install -C -o root -g wheel -m 644 "$branding/motd" /var/run/motd
	[ -h /etc/motd ] || ln -sf ../var/run/motd /etc/motd

	# The boot menu (our brand and logo) draws on the firmware's screen
	# console and the serial one. The loader rejects the whole list if one
	# name doesn't exist, so match it to how this machine boots.
	case $(sysctl -n machdep.bootmethod 2>/dev/null) in
	UEFI) console="efi" ;;
	*) console="comconsole,vidconsole" ;;
	esac
	if [ "$(sysrc -f /boot/loader.conf -n console 2>/dev/null)" != "$console" ]; then
		sysrc -q -f /boot/loader.conf console="$console" >/dev/null
	fi
}

load_rc_config "$name"
: "${glasshouse_identity_enable:=NO}"

run_rc_command "$1"
