# FreeBSD release pins: the single source of truth for os/freebsd/scripts.
# Plain KEY=value lines (no quotes) so both bash and make can read this file.
# To bump: edit FREEBSD_VERSION, run `os/freebsd/scripts/fetch.sh --print-pins`,
# paste the printed sums below, then `make freebsd-fetch freebsd-sysroot vm-reset`.

FREEBSD_VERSION=15.1
FREEBSD_RELEASE=15.1-RELEASE
FREEBSD_ARCH=amd64
FREEBSD_TRIPLE=x86_64-unknown-freebsd15.1
FREEBSD_MIRROR=https://download.freebsd.org/releases

# ZFS-root cloud-init VM image (nuageinit). Pinned from that directory's CHECKSUM.SHA256.
FREEBSD_VM_IMAGE_URL=${FREEBSD_MIRROR}/VM-IMAGES/${FREEBSD_RELEASE}/${FREEBSD_ARCH}/Latest
FREEBSD_VM_IMAGE=FreeBSD-${FREEBSD_RELEASE}-${FREEBSD_ARCH}-BASIC-CLOUDINIT-zfs.qcow2.xz
FREEBSD_VM_IMAGE_SHA256=4159e137d4a78f46b62d3523edd9a4dc79fd0cdcf17e34e531342f52333f4131

# Base distribution set, used only to build the cross-compile sysroot. Pinned from MANIFEST.
FREEBSD_BASE_URL=${FREEBSD_MIRROR}/${FREEBSD_ARCH}/${FREEBSD_RELEASE}
FREEBSD_BASE_TXZ=base.txz
FREEBSD_BASE_TXZ_SHA256=3768988b151c20f965679062b065c63a977d6bbb9f47fd83695ec2c40790c18f

# Source distribution set, only for the base system's license notices and
# source offer (`make legal-base`, BR-2, BR-3). Pinned from MANIFEST.
FREEBSD_SRC_TXZ=src.txz
FREEBSD_SRC_TXZ_SHA256=cf5762da53fd52e1eaf0f9ceee9bf58cbe314c821031d0d9ffa76823185a89e1
