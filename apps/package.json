{
  "name": "glasshouse-apps",
  "private": true,
  "description": "Glasshouse's first-party web apps and their SDK (ADR 0009, 0024). Their OS actions live in crates/apps.",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "sdk",
    "mail",
    "calendar",
    "store"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p sdk/tsconfig.sw.json",
    "test:unit": "node --test --test-reporter=spec \"sdk/test/*.test.ts\" \"mail/test/*.test.ts\" \"calendar/test/*.test.ts\" \"store/test/*.test.ts\"",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "lint": "tsc -p tsconfig.json && tsc -p sdk/tsconfig.sw.json && node check-manifests.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "esbuild": "0.25.12",
    "typescript": "6.0.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
