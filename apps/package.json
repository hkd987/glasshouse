{
  "name": "glasshouse-apps",
  "private": true,
  "description": "Glasshouse's first-party web apps and their SDK (ADR 0009, 0024). Their OS actions live in crates/apps.",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "sdk",
    "mail",
    "calendar",
    "store",
    "settings",
    "routines",
    "chat",
    "meet",
    "artifacts",
    "docs"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p sdk/tsconfig.sw.json",
    "test:unit": "node --test --test-reporter=spec \"sdk/test/*.test.ts\" \"mail/test/*.test.ts\" \"calendar/test/*.test.ts\" \"store/test/*.test.ts\" \"routines/test/*.test.ts\" \"chat/test/*.test.ts\" \"meet/test/*.test.ts\" \"artifacts/test/*.test.ts\" \"docs/test/*.test.ts\" \"agents/test/*.test.ts\"",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "lint": "tsc -p tsconfig.json && tsc -p sdk/tsconfig.sw.json && node check-manifests.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "esbuild": "0.25.12",
    "typescript": "6.0.2"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "lib0": "0.2.119",
    "prosemirror-commands": "1.7.2",
    "prosemirror-dropcursor": "1.8.4",
    "prosemirror-gapcursor": "1.4.1",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-tables": "1.8.5",
    "prosemirror-transform": "1.12.2",
    "prosemirror-view": "1.42.6",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  }
}
