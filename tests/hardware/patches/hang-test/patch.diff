A module that never finishes loading, on purpose: the kernel patch whose
start hangs, for tests/hardware/patch-vm.sh (ADR 0057). Never shipped.

diff --git b/sys/dev/glass_hang_test/glass_hang_test.c b/sys/dev/glass_hang_test/glass_hang_test.c
new file mode 100644
index 0000000..d821c22
--- /dev/null
+++ b/sys/dev/glass_hang_test/glass_hang_test.c
@@ -0,0 +1,30 @@
+/*
+ * A module that never finishes loading, on purpose: the kernel patch whose
+ * start hangs (ADR 0057, tests/hardware/patch-vm.sh). The start-once is
+ * spent, so the start after the person turns the computer off and on again
+ * is the boot environment before. Never shipped.
+ */
+#include <sys/param.h>
+#include <sys/kernel.h>
+#include <sys/module.h>
+#include <sys/systm.h>
+#include <machine/cpu.h>
+
+static int
+glass_hang_test_modevent(module_t mod __unused, int type, void *arg __unused)
+{
+	if (type == MOD_LOAD) {
+		printf("glass_hang_test: hangs as it loads, on purpose (ADR 0057)\n");
+		for (;;)
+			cpu_spinwait();
+	}
+	return (0);
+}
+
+static moduledata_t glass_hang_test_mod = {
+	"glass_hang_test",
+	glass_hang_test_modevent,
+	NULL
+};
+DECLARE_MODULE(glass_hang_test, glass_hang_test_mod, SI_SUB_DRIVERS, SI_ORDER_ANY);
+MODULE_VERSION(glass_hang_test, 1);
